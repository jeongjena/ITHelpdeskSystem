@model ITHelpdeskSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<!-- Status summary cards -->
<div class="row g-3 mb-4">
    <div class="col-auto">
        <div class="card text-center" style="min-width: 140px;">
            <div class="card-body">
                <h6 class="card-title">Open</h6>
                <p class="fs-3 mb-0">@Model.OpenCount</p>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card text-center" style="min-width: 140px;">
            <div class="card-body">
                <h6 class="card-title">In Progress</h6>
                <p class="fs-3 mb-0">@Model.InProgressCount</p>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card text-center" style="min-width: 140px;">
            <div class="card-body">
                <h6 class="card-title">Resolved</h6>
                <p class="fs-3 mb-0">@Model.ResolvedCount</p>
            </div>
        </div>
    </div>
</div>

<!-- Priority summary cards -->
<div class="row g-3 mb-4">
    <div class="col-auto">
        <div class="card text-center" style="min-width: 140px;">
            <div class="card-body">
                <h6 class="card-title">High</h6>
                <p class="fs-3 mb-0">@Model.HighPriorityCount</p>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card text-center" style="min-width: 140px;">
            <div class="card-body">
                <h6 class="card-title">Medium</h6>
                <p class="fs-3 mb-0">@Model.MediumPriorityCount</p>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card text-center" style="min-width: 140px;">
            <div class="card-body">
                <h6 class="card-title">Low</h6>
                <p class="fs-3 mb-0">@Model.LowPriorityCount</p>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card text-center" style="min-width: 140px;">
            <div class="card-body">
                <h6 class="card-title">Unassigned</h6>
                <p class="fs-3 mb-0">@Model.UnassignedPriorityCount</p>
            </div>
        </div>
    </div>
</div>

<!-- Requires Attention: tickets overdue for triage or resolution -->
<h4 class="mb-3">Requires Attention</h4>

@if (!Model.OverdueTickets.Any())
{
    <p class="text-muted">No overdue tickets.</p>
}
else
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Ticket ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Assigned Technician</th>
                <th>Overdue SLA</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.OverdueTickets)
            {
                <tr>
                    <td>@ticket.TicketId</td>
                    <td>@ticket.Title</td>
                    <td>@ticket.Status</td>
                    <td>@ticket.Priority</td>
                    <td>@(ticket.AssignedTechnician ?? "-")</td>
                    <td><span class="text-danger fw-bold">@ticket.OverdueSla</span></td>
                    <td>
                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.TicketId"
                           class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}