@model ITHelpdeskSystem.Models.Ticket

@{
    ViewData["Title"] = "Triage Ticket";
}

<h1>Triage Ticket #@Model.Id</h1>

<div class="mb-4">
    <h4>@Model.Title</h4>

    <p>
        <strong>Requester:</strong>
        @Model.RequesterName (@Model.RequesterEmail)
    </p>

    <p>
        <strong>Description:</strong><br />
        @Model.Description
    </p>

    <p>
        <strong>Created:</strong>
        @Model.CreatedAt.ToLocalTime()
    </p>

    <p>
        <strong>Current Status:</strong>
        @Model.Status
    </p>
</div>

<hr />

<h4>Complete Triage</h4>

<form asp-action="Triage" method="post">

    <!-- Identifies which ticket is being updated. -->
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Priority" class="form-label"></label>

        <select asp-for="Priority"
                asp-items="Html.GetEnumSelectList<ITHelpdeskSystem.Models.TicketPriority>()"
                class="form-select">
        </select>
        <span asp-validation-for="Priority"
                class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AssignedTechnician"
               class="form-label"></label>

        <input asp-for="AssignedTechnician"
               class="form-control" />

        <span asp-validation-for="AssignedTechnician"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Complete Triage
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}