@model ITHelpdeskSystem.ViewModels.RequesterTicketResultViewModel

@{
    ViewData["Title"] = "Ticket Details";
}

<h1 class="h4">Ticket #@Model.TicketId</h1>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text">@Model.Description</p>

        <dl class="row">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAtNz</dd>
        </dl>
    </div>
</div>

<h2 class="h5">Progress Updates</h2>

@if (Model.Comments.Count == 0)
{
    <p class="text-muted">No progress updates yet.</p>
}
else
{
    @foreach (var comment in Model.Comments)
    {
        <div class="border rounded p-3 mb-3">
            <p class="mb-1">@comment.Text</p>
            <small class="text-muted">
                @comment.CreatedAtNz.ToString("dd MMM yyyy, h:mm tt")
            </small>
        </div>
    }
}

<p>
    <a asp-action="Track"
       class="btn btn-secondary">
        Lookup another ticket
    </a>
</p>