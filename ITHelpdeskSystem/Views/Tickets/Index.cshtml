@model IEnumerable<ITHelpdeskSystem.Models.Ticket>

@{
    ViewData["Title"] = "Ticket Management";
}

<h1>Ticket Management</h1>
<!-- Search and filter form for the ticket list. Uses GET so filters appear in the URL. -->
<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label">Search</label>
        <!-- Matches against Ticket ID, Title, or Requester Name (handled in the controller) -->
        <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]"
               class="form-control" placeholder="ID, Title, or Requester" />
    </div>

    <div class="col-auto">
        <label class="form-label">Status</label>
        <!-- "All" (empty value) means no status filter is applied -->
        <select name="status" class="form-select">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<ITHelpdeskSystem.Models.TicketStatus>())
            {
                <option value="@s" selected="@(ViewData["StatusFilter"]?.ToString() == s.ToString())">
                    @s
                </option>
            }
        </select>
    </div>

    <div class="col-auto">
        <label class="form-label">Priority</label>
        <!-- "All" (empty value) means no priority filter is applied.
             Note: Unassigned is a real, selectable priority value, not the same as "All". -->
        <select name="priority" class="form-select">
            <option value="">All</option>
            @foreach (var p in Enum.GetValues<ITHelpdeskSystem.Models.TicketPriority>())
            {
                <option value="@p" selected="@(ViewData["PriorityFilter"]?.ToString() == p.ToString())">
                    @p
                </option>
            }
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <!-- Clear resets by navigating back to Index with no query parameters -->
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any())
{
    <!-- No tickets matched the current search/filter criteria -->
    <p class="text-muted">No tickets match your search/filter criteria.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Requester</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Technician</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>#@ticket.Id</td>

                    <td>@ticket.Title</td>

                    <td>@ticket.RequesterName</td>

                    <td>
                        @{
                            var priorityClass = ticket.Priority switch
                            {
                                ITHelpdeskSystem.Models.TicketPriority.High => "bg-danger",
                                ITHelpdeskSystem.Models.TicketPriority.Medium => "bg-warning text-dark",
                                ITHelpdeskSystem.Models.TicketPriority.Low => "bg-success",
                                ITHelpdeskSystem.Models.TicketPriority.Unassigned => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @priorityClass">@ticket.Priority</span>
                    </td>

                    <td>
                        @{
                            var statusClass = ticket.Status switch
                            {
                                ITHelpdeskSystem.Models.TicketStatus.Open => "bg-primary",
                                ITHelpdeskSystem.Models.TicketStatus.InProgress => "bg-warning text-dark",
                                ITHelpdeskSystem.Models.TicketStatus.Resolved => "bg-success",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@ticket.Status</span>
                    </td>

                    <td>
                        @(ticket.AssignedTechnician ?? "Unassigned")
                    </td>

                    <td>
                        @ticket.CreatedAt.ToLocalTime()
                    </td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-secondary">
                            Details
                        </a>

                        @if (ticket.Status == ITHelpdeskSystem.Models.TicketStatus.Open)
                        {
                            <a asp-action="Triage"
                               asp-route-id="@ticket.Id"
                               class="btn btn-sm btn-primary">
                                Triage
                            </a>
                        }
                        else if (ticket.Status == ITHelpdeskSystem.Models.TicketStatus.InProgress)
                        {
                            <a asp-action="Resolve"
                               asp-route-id="@ticket.Id"
                               class="btn btn-sm btn-success">
                                Resolve
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Resolved</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}